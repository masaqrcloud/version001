[Unit]
Description=MasaQR weekly venue report email
After=network.target nextapp.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/masaqr
Environment=APP_DIR=/home/ubuntu/masaqr
Environment=APP_ORIGIN=http://127.0.0.1:3000
ExecStart=/bin/bash /home/ubuntu/masaqr/scripts/week-summary.sh
