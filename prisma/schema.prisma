generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  PLATFORM
  OWNER
  ADMIN
  WAITER
  KITCHEN
}

enum SessionStatus {
  OPEN
  CLOSED
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum BillStatus {
  UNPAID
  PAID
}

model Venue {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  tagline   String?
  logoUrl   String?
  coverUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  tables     Table[]
  categories MenuCategory[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  venueId      String?
  venue        Venue?   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Table {
  id        String   @id @default(cuid())
  number    String
  qrToken   String   @unique @default(cuid())
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  sessions  TableSession[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([venueId, number])
}

model TableSession {
  id        String        @id @default(cuid())
  tableId   String
  table     Table         @relation(fields: [tableId], references: [id], onDelete: Cascade)
  status    SessionStatus @default(OPEN)
  openedAt       DateTime      @default(now())
  closedAt       DateTime?
  waiterCalledAt DateTime?
  guests         Guest[]
  orders    Order[]
  bill      Bill?
}

model Guest {
  id             String       @id @default(cuid())
  tableSessionId String
  tableSession   TableSession @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  guestToken     String       @unique
  nickname       String?
  createdAt      DateTime     @default(now())
  cartItems      CartItem[]
  orders         Order[]
  notifications  GuestNotification[]
}

model GuestNotification {
  id        String   @id @default(cuid())
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model MenuCategory {
  id        String     @id @default(cuid())
  venueId   String
  venue     Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int        @default(0)
  items     MenuItem[]
}

model MenuItem {
  id          String       @id @default(cuid())
  categoryId  String
  category    MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Decimal
  imageUrl    String?
  available   Boolean      @default(true)
  sortOrder   Int          @default(0)
  cartItems   CartItem[]
  orderItems  OrderItem[]
}

model CartItem {
  id         String   @id @default(cuid())
  guestId    String
  guest      Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([guestId, menuItemId])
}

model Order {
  id             String       @id @default(cuid())
  tableSessionId String
  tableSession   TableSession @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  guestId        String
  guest          Guest        @relation(fields: [guestId], references: [id], onDelete: Cascade)
  guestName      String?
  status         OrderStatus  @default(PENDING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  items          OrderItem[]
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  name       String
  price      Decimal
  quantity   Int
  note       String?
}

model Bill {
  id             String       @id @default(cuid())
  tableSessionId String       @unique
  tableSession   TableSession @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  status         BillStatus   @default(UNPAID)
  total          Decimal
  paidAt         DateTime?
  createdAt      DateTime     @default(now())
}
