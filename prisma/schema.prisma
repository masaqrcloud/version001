generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  PLATFORM
  OWNER
  ADMIN
  WAITER
  KITCHEN
}

enum SessionStatus {
  OPEN
  CLOSED
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum BillStatus {
  UNPAID
  PAID
}

enum ApplicationStatus {
  NEW
  REVIEWED
  APPROVED
  REJECTED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

enum StockMovementReason {
  ORDER
  CANCEL
  RECEIVE
  WASTE
  COUNT
  ADJUST
}

model Application {
  id         String            @id @default(cuid())
  fullName   String
  email      String
  phone      String?
  venueName  String
  city       String?
  venueType  String?
  message    String?
  status     ApplicationStatus @default(NEW)
  reviewedAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([status, createdAt])
}

model Venue {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  tagline      String?
  logoUrl      String?
  coverUrl     String?
  openingHours String?
  wifiName     String?
  wifiPassword String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users           User[]
  tables          Table[]
  categories      MenuCategory[]
  reservations    Reservation[]
  stockMovements  StockMovement[]
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  name                String
  role                Role
  venueId             String?
  venue               Venue?               @relation(fields: [venueId], references: [id], onDelete: Cascade)
  passwordResetTokens PasswordResetToken[]
  pushSubscriptions   PushSubscription[]
  orderStatusEvents   OrderStatusEvent[]
  cancelledOrders     Order[]              @relation("OrderCancelledBy")
  stockMovements      StockMovement[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model Table {
  id              String         @id @default(cuid())
  number          String
  qrToken         String         @unique @default(cuid())
  floorX          Int?
  floorY          Int?
  venueId         String
  venue           Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  sessions        TableSession[] @relation("TableHomeSession")
  mergedSessionId String?
  mergedSession   TableSession?  @relation("SessionMergedTables", fields: [mergedSessionId], references: [id], onDelete: SetNull)
  reservations    Reservation[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([venueId, number])
  @@index([mergedSessionId])
}

model TableSession {
  id             String            @id @default(cuid())
  tableId        String
  table          Table             @relation("TableHomeSession", fields: [tableId], references: [id], onDelete: Cascade)
  status         SessionStatus     @default(OPEN)
  openedAt       DateTime          @default(now())
  closedAt       DateTime?
  waiterCalledAt DateTime?
  billRequestedAt DateTime?
  guests         Guest[]
  orders         Order[]
  bill           Bill?
  feedback       SessionFeedback[]
  mergedTables   Table[]           @relation("SessionMergedTables")
}

model Guest {
  id             String              @id @default(cuid())
  tableSessionId String
  tableSession   TableSession        @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  guestToken     String              @unique
  nickname       String?
  receiptEmail   String?
  receiptSentAt  DateTime?
  waiterCalledAt DateTime?
  billRequestedAt DateTime?
  createdAt      DateTime            @default(now())
  cartItems      CartItem[]
  orders         Order[]
  notifications  GuestNotification[]
  feedback       SessionFeedback[]
}

model GuestNotification {
  id        String   @id @default(cuid())
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model MenuCategory {
  id        String     @id @default(cuid())
  venueId   String
  venue     Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int        @default(0)
  items     MenuItem[]
}

model MenuItem {
  id                String            @id @default(cuid())
  categoryId        String
  category          MenuCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  price             Decimal
  imageUrl          String?
  available         Boolean           @default(true)
  stockTracked      Boolean           @default(false)
  stockQuantity     Int               @default(0)
  lowStockThreshold Int               @default(5)
  sortOrder         Int               @default(0)
  cartItems         CartItem[]
  orderItems        OrderItem[]
  optionGroups      MenuOptionGroup[]
  stockMovements    StockMovement[]
}

model StockMovement {
  id            String              @id @default(cuid())
  venueId       String
  venue         Venue               @relation(fields: [venueId], references: [id], onDelete: Cascade)
  menuItemId    String
  menuItem      MenuItem            @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  delta         Int
  quantityAfter Int
  reason        StockMovementReason
  note          String?
  orderId       String?
  order         Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actorId       String?
  actor         User?               @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt     DateTime            @default(now())

  @@index([venueId, createdAt])
  @@index([menuItemId, createdAt])
}

model MenuOptionGroup {
  id            String       @id @default(cuid())
  menuItemId    String
  menuItem      MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name          String
  required      Boolean      @default(false)
  minSelections Int          @default(0)
  maxSelections Int          @default(1)
  sortOrder     Int          @default(0)
  options       MenuOption[]

  @@index([menuItemId, sortOrder])
}

model MenuOption {
  id              String           @id @default(cuid())
  groupId         String
  group           MenuOptionGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name            String
  priceDelta      Decimal          @default(0)
  available       Boolean          @default(true)
  sortOrder       Int              @default(0)
  cartItemOptions CartItemOption[]

  @@index([groupId, sortOrder])
}

model Reservation {
  id              String            @id @default(cuid())
  venueId         String
  venue           Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  tableId         String?
  table           Table?            @relation(fields: [tableId], references: [id], onDelete: SetNull)
  fullName        String
  email           String
  phone           String
  guestCount      Int
  reservationDate String
  reservationTime String
  note            String?
  status          ReservationStatus @default(PENDING)
  reviewedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([venueId, reservationDate, reservationTime])
  @@index([status, createdAt])
}

model CartItem {
  id           String           @id @default(cuid())
  guestId      String
  guest        Guest            @relation(fields: [guestId], references: [id], onDelete: Cascade)
  menuItemId   String
  menuItem     MenuItem         @relation(fields: [menuItemId], references: [id])
  quantity     Int
  note         String?
  selectionKey String           @default("")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  options      CartItemOption[]

  @@unique([guestId, menuItemId, selectionKey])
}

model CartItemOption {
  id         String     @id @default(cuid())
  cartItemId String
  cartItem   CartItem   @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  optionId   String
  option     MenuOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([cartItemId, optionId])
}

model Order {
  id                String             @id @default(cuid())
  tableSessionId    String
  tableSession      TableSession       @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  guestId           String
  guest             Guest              @relation(fields: [guestId], references: [id], onDelete: Cascade)
  guestName         String?
  status            OrderStatus        @default(PENDING)
  idempotencyKey    String?            @unique
  cancelledAt       DateTime?
  cancelledByUserId String?
  cancelledBy       User?              @relation("OrderCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  cancelReason      String?
  stockRestoredAt   DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  items             OrderItem[]
  statusEvents      OrderStatusEvent[]
  stockMovements    StockMovement[]

  @@index([tableSessionId, status])
  @@index([guestId, createdAt])
}

model OrderItem {
  id         String            @id @default(cuid())
  orderId    String
  order      Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem          @relation(fields: [menuItemId], references: [id])
  name       String
  price      Decimal
  quantity   Int
  note       String?
  options    OrderItemOption[]
}

model OrderItemOption {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  name        String
  priceDelta  Decimal   @default(0)
}

model OrderStatusEvent {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorId    String?
  actor      User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  reason     String?
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model SessionFeedback {
  id             String       @id @default(cuid())
  tableSessionId String
  tableSession   TableSession @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  guestId        String
  guest          Guest        @relation(fields: [guestId], references: [id], onDelete: Cascade)
  rating         Int
  comment        String?
  createdAt      DateTime     @default(now())

  @@unique([tableSessionId, guestId])
  @@index([tableSessionId, createdAt])
}

model Bill {
  id             String       @id @default(cuid())
  tableSessionId String       @unique
  tableSession   TableSession @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  status         BillStatus   @default(UNPAID)
  total          Decimal
  paidAt         DateTime?
  createdAt      DateTime     @default(now())
}
