generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  PLATFORM
  OWNER
  ADMIN
  WAITER
  KITCHEN
}

enum SessionStatus {
  OPEN
  CLOSED
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum BillStatus {
  UNPAID
  PAID
}

enum ApplicationStatus {
  NEW
  REVIEWED
  APPROVED
  REJECTED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

model Application {
  id        String            @id @default(cuid())
  fullName  String
  email     String
  phone     String?
  venueName String
  city      String?
  venueType String?
  message   String?
  status    ApplicationStatus @default(NEW)
  reviewedAt DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([status, createdAt])
}

model Venue {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  tagline   String?
  logoUrl   String?
  coverUrl  String?
  openingHours String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  tables     Table[]
  categories MenuCategory[]
  reservations Reservation[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  venueId      String?
  venue        Venue?   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  passwordResetTokens PasswordResetToken[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model Table {
  id        String   @id @default(cuid())
  number    String
  qrToken   String   @unique @default(cuid())
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  sessions  TableSession[]
  reservations Reservation[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([venueId, number])
}

model TableSession {
  id        String        @id @default(cuid())
  tableId   String
  table     Table         @relation(fields: [tableId], references: [id], onDelete: Cascade)
  status    SessionStatus @default(OPEN)
  openedAt       DateTime      @default(now())
  closedAt       DateTime?
  waiterCalledAt DateTime?
  guests         Guest[]
  orders    Order[]
  bill      Bill?
}

model Guest {
  id             String       @id @default(cuid())
  tableSessionId String
  tableSession   TableSession @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  guestToken     String       @unique
  nickname       String?
  receiptEmail   String?
  receiptSentAt  DateTime?
  createdAt      DateTime     @default(now())
  cartItems      CartItem[]
  orders         Order[]
  notifications  GuestNotification[]
}

model GuestNotification {
  id        String   @id @default(cuid())
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model MenuCategory {
  id        String     @id @default(cuid())
  venueId   String
  venue     Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int        @default(0)
  items     MenuItem[]
}

model MenuItem {
  id          String       @id @default(cuid())
  categoryId  String
  category    MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Decimal
  imageUrl    String?
  available   Boolean      @default(true)
  stockTracked Boolean     @default(false)
  stockQuantity Int        @default(0)
  lowStockThreshold Int     @default(5)
  sortOrder   Int          @default(0)
  cartItems   CartItem[]
  orderItems  OrderItem[]
}

model Reservation {
  id              String            @id @default(cuid())
  venueId         String
  venue           Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  tableId         String?
  table           Table?            @relation(fields: [tableId], references: [id], onDelete: SetNull)
  fullName        String
  email           String
  phone           String
  guestCount      Int
  reservationDate String
  reservationTime String
  note            String?
  status          ReservationStatus @default(PENDING)
  reviewedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([venueId, reservationDate, reservationTime])
  @@index([status, createdAt])
}

model CartItem {
  id         String   @id @default(cuid())
  guestId    String
  guest      Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([guestId, menuItemId])
}

model Order {
  id             String       @id @default(cuid())
  tableSessionId String
  tableSession   TableSession @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  guestId        String
  guest          Guest        @relation(fields: [guestId], references: [id], onDelete: Cascade)
  guestName      String?
  status         OrderStatus  @default(PENDING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  items          OrderItem[]
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  name       String
  price      Decimal
  quantity   Int
  note       String?
}

model Bill {
  id             String       @id @default(cuid())
  tableSessionId String       @unique
  tableSession   TableSession @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  status         BillStatus   @default(UNPAID)
  total          Decimal
  paidAt         DateTime?
  createdAt      DateTime     @default(now())
}
